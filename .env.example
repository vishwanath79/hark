# Ollama (default provider). Only needed if using a remote Ollama host.
# For local Ollama, these can be omitted.
OLLAMA_API_KEY=your-api-key
OLLAMA_HOST=https://your-ollama-host.com
OLLAMA_MODEL=your-model-name

# OpenAI (optional). Uncomment and set if using openai: models.
# OPENAI_API_KEY=sk-your-openai-key

# Anthropic (optional). Uncomment and set if using anthropic: models.
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key